{
  "name": "mmm-librarymonitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-LibraryMonitor.git"
  },
  "bugs": {
    "url": "https://github.com/HeikoGr/MMM-LibraryMonitor/issues"
  },
  "homepage": "https://github.com/HeikoGr/MMM-LibraryMonitor#readme",
  "version": "0.3.0",
  "description": "MagicMirror module to display borrowed media and due dates from library OPAC accounts.",
  "main": "MMM-LibraryMonitor.js",
  "type": "commonjs",
  "author": "HeikoGr",
  "keywords": [
    "magicmirror",
    "magicmirror-module",
    "library-monitor",
    "open-opac",
    "library",
    "books",
    "media"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "test": "node --test tests/*.test.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "node --run mmcheck",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current",
    "debug:live": "node scripts/live-account-fetch.js",
    "deps:update": "npx --yes npm-check-updates -u && npm install && npx @biomejs/biome migrate --write",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
