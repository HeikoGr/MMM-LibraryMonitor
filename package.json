{
  "name": "mmm-librarymonitor",
  "version": "0.7.0",
  "private": true,
  "description": "MagicMirror module to display borrowed media and due dates from library OPAC accounts.",
  "keywords": [
    "magicmirror",
    "magicmirror-module",
    "library-monitor",
    "open-opac",
    "library",
    "books",
    "media"
  ],
  "homepage": "https://github.com/HeikoGr/MMM-LibraryMonitor#readme",
  "bugs": {
    "url": "https://github.com/HeikoGr/MMM-LibraryMonitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-LibraryMonitor.git"
  },
  "license": "MIT",
  "author": "HeikoGr",
  "type": "commonjs",
  "main": "MMM-LibraryMonitor.js",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/magicmirror-check.mjs --current",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared",
    "deps:update": "npx --yes npm-check-updates -u && npm install && biome migrate --write",
    "debug:live": "node scripts/live-account-fetch.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "node scripts/check-commit-msg.js $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
